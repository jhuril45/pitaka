# Copy to .env.local and fill in from Back4App → App Settings → Security & Keys.
# Only the Application ID and JavaScript Key go here. The master key and any
# third-party API keys live in Back4App Cloud Code environment variables only.
EXPO_PUBLIC_PARSE_APP_ID=
EXPO_PUBLIC_PARSE_JS_KEY=
EXPO_PUBLIC_PARSE_SERVER_URL=https://parseapi.back4app.com
